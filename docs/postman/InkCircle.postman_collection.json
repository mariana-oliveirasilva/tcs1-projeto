{
  "info": {
    "name": "InkCircle — Etapas 6 e 7",
    "description": "Executar em ordem com o armazenamento de cookies do Postman ativo. Cada execução cadastra uma conta de teste.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "usuario",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "avaliacaoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Saúde",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/saude"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Cadastrar conta",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/contas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Leitora de teste\",\n  \"usuario\": \"{{usuario}}\",\n  \"email\": \"{{email}}\",\n  \"senha\": \"SenhaDemo123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const usuario = \"teste_\" + pm.variables.replaceIn(\"{{$randomUUID}}\").replace(/-/g, \"\").slice(0, 12);",
              "pm.collectionVariables.set(\"usuario\", usuario);",
              "pm.collectionVariables.set(\"email\", usuario + \"@example.com\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "Entrar",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/sessao",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"senha\": \"SenhaDemo123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Consultar sessão",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/sessao"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Publicar avaliação",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/avaliacoes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"obra\": \"Dom Casmurro\",\n  \"tipo\": \"livro\",\n  \"nota\": 5,\n  \"comentario\": \"Um romance cheio de ambiguidades.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"avaliacaoId\", String(pm.response.json().id));",
              "pm.test(\"Location identifica a avaliação\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/avaliacoes/\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar avaliações",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/avaliacoes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Consultar avaliação",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/avaliacoes/{{avaliacaoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Ver avaliação no perfil",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/meu-perfil"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Avaliação da sessão no perfil\", () => pm.expect(pm.response.json().avaliacoes.map(a => String(a.id))).to.include(pm.collectionVariables.get(\"avaliacaoId\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "Recusar nota inválida",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/avaliacoes/{{avaliacaoId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nota\": 6\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 422\", () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "Editar avaliação",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/avaliacoes/{{avaliacaoId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nota\": 4\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Nota alterada\", () => pm.expect(pm.response.json().nota).to.equal(4));"
            ]
          }
        }
      ]
    },
    {
      "name": "Excluir avaliação",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/avaliacoes/{{avaliacaoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Confirmar exclusão",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/avaliacoes/{{avaliacaoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Sair",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/sessao"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Confirmar sessão encerrada",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/meu-perfil"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}
